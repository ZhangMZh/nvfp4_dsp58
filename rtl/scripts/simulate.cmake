# SPDX-License-Identifier: MIT
include("${CONFIG}")
foreach(tool IN ITEMS XVLOG XELAB XSIM)
    require_tool(${tool})
endforeach()
if(NOT EXISTS "${VIVADO_ROOT}/data/verilog/src/glbl.v")
    message(FATAL_ERROR "Set XILINX_VIVADO or configure -DVIVADO_ROOT=/path/to/Vivado")
endif()
prepare_work("${WORK}")
set(files "${ROOT}/rtl/generated/${RTL_FAMILY}.sv"
    "${ROOT}/rtl/generated/${RTL_FAMILY}_axis.sv" "${ROOT}/rtl/generated/${RTL_FAMILY}_rtl.sv")
set(testbench tb_dot16)
set(latency ${CORE_LATENCY})
set(defines)
if(KIND STREQUAL "core")
    set(testbench tb_core)
elseif(KIND STREQUAL "fifo")
    set(defines -d TEST_FIFO)
elseif(KIND STREQUAL "integration")
    list(APPEND files "${ROOT}/rtl/tb/nvfp4_dot16_fixture.sv")
    set(defines -d TEST_INTEGRATION)
    math(EXPR latency "${CORE_LATENCY} + 2")
elseif(KIND STREQUAL "hls")
    file(GLOB files "${HLS_RTL}/*.v" "${HLS_RTL}/*.sv")
    set(defines -d TEST_HLS)
elseif(NOT KIND STREQUAL "axis")
    message(FATAL_ERROR "Unknown simulation kind: ${KIND}")
endif()
if(BLOCK_SCALING)
    list(APPEND defines -d BLOCK_SCALING=1)
endif()
run_tool("${WORK}" compile "" "${XVLOG}" --sv ${defines} ${files}
    "${ROOT}/rtl/tb/${testbench}.sv" "${VIVADO_ROOT}/data/verilog/src/glbl.v")
set(generics)
set(marker "PASS core")
if(NOT KIND STREQUAL "core")
    set(generics -generic_top "CORE_LATENCY=${latency}")
    set(marker "PASS dot16")
endif()
file(STRINGS "${VECTORS}" vectors)
list(LENGTH vectors count)
list(APPEND generics -generic_top "VECTOR_COUNT=${count}")
run_tool("${WORK}" elaborate "" "${XELAB}" "${testbench}" glbl -L unisims_ver
    -s sim -mt 2 ${generics})
run_tool("${WORK}" simulate "${marker}" "${XSIM}" sim -runall
    --testplusarg "vectors=${VECTORS}" --testplusarg "count=${count}")
