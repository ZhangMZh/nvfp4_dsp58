# SPDX-License-Identifier: MIT
# Configured paths and parameters shared by build-time CMake scripts.
cmake_minimum_required(VERSION 3.20)
set(ROOT [==[@ROOT@]==])
set(BUILD [==[@BUILD@]==])
set(PART [==[@PART@]==])
set(CLOCK_NS [==[@CLOCK_NS@]==])
set(BLOCK_SCALING @BLOCK_SCALING@)
set(SBT [==[@SBT@]==])
set(VIVADO [==[@VIVADO@]==])
set(VIVADO_ROOT [==[@VIVADO_ROOT@]==])
set(VITIS_RUN [==[@VITIS_RUN@]==])
set(XVLOG [==[@XVLOG@]==])
set(XELAB [==[@XELAB@]==])
set(XSIM [==[@XSIM@]==])
set(VECTORS "${BUILD}/tests/vectors.mem")
# Shared mode metadata for simulation, HLS descriptors and physical checks.
# FF/LUT are conservative blackbox budgets; routed reports remain authoritative.
set(RTL_FAMILY nvfp4_dot16)
set(INPUT_WIDTH 128)
set(OUTPUT_WIDTH 16)
set(CORE_LATENCY 2)
set(HLS_LATENCY 6)
set(DSP_COUNT 4)
set(CORE_FF 42)
set(FIFO_LUT 149)
set(SCALING_CFLAG "")
if(BLOCK_SCALING)
    set(BLOCK_SCALING 1)
    set(RTL_FAMILY nvfp4_scaled_dot16)
    set(INPUT_WIDTH 144)
    set(OUTPUT_WIDTH 64)
    set(CORE_LATENCY 5)
    set(HLS_LATENCY 9)
    set(DSP_COUNT 5)
    set(CORE_FF 132)
    set(FIFO_LUT 287)
    set(SCALING_CFLAG "-DBLOCK_SCALING=1")
else()
    set(BLOCK_SCALING 0)
endif()
include("${ROOT}/cmake/RunTool.cmake")
