include("${CONFIG}")
require_tool(VITIS_RUN)
set(WORK "${BUILD}/hls-${MODE}")
prepare_work("${WORK}")
configure_file("${VECTORS}" "${WORK}/vectors.mem" COPYONLY)
configure_file("${BUILD}/hls/dot16.json" "${WORK}/dot16.json" COPYONLY)
run_tool("${WORK}" "${MODE}" DOT16_FLOW_PASS
    "${VITIS_RUN}" --mode hls --tcl "${BUILD}/hls/${MODE}.tcl")
if(MODE STREQUAL "cosim")
    set(HLS_RTL "${WORK}/project/solution/syn/verilog")
    set(WORK "${WORK}/hls")
    set(KIND hls)
    include("${ROOT}/rtl/scripts/simulate.cmake")
elseif(MODE STREQUAL "ip")
    include("${ROOT}/cmake/Archive.cmake")
    file(GLOB archives "${WORK}/project/solution/impl/ip/*.zip")
    list(LENGTH archives count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one HLS IP archive, found ${count}")
    endif()
    package_docs("${archives}" "${WORK}/archive")
endif()
